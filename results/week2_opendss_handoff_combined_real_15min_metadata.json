        "grid_import_kw": "kW",
        "grid_export_kw": "kW",
        "battery_soc_kWh": "kWh",
        "battery_net_injection_kw": "kW",
        "grid_net_import_kw": "kW"
    },
    "sign_conventions": {
        "battery_net_injection_kW": "Positive supplies the feeder; negative consumes from the feeder.",
        "grid_net_import_kw": "Positive imports from the utility;negative exports to the utility."
    },
    "formulas": {
        "battery_net_injection_kw": "battery_discharge_kw - battery_charge_kw",
        "grid_net_import_kw": "grid_import - grid_export_kw"
